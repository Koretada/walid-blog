---
import type { GetStaticPaths } from 'astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVisiblePosts, type BlogPost } from '../../utils/posts';
import { postsByTerm, summarizeTerms } from '../../utils/taxonomy';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getVisiblePosts();
  const categories = summarizeTerms(posts, 'categories');
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { term: category.term, posts: postsByTerm(posts, 'categories', category.slug) },
  }));
};

interface Props {
  term: string;
  posts: BlogPost[];
}

const { term, posts } = Astro.props;
---

<BaseLayout title={`Catégorie : ${term}`} description={`Articles de la catégorie « ${term} ».`}>
  <Breadcrumbs
    items={[
      { label: 'Accueil', href: '/' },
      { label: 'Catégories', href: '/categories' },
      { label: term },
    ]}
  />

  <header class="mt-6">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">{term}</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">
      {posts.length}
      {posts.length > 1 ? 'articles' : 'article'}
    </p>
  </header>

  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </div>
</BaseLayout>
