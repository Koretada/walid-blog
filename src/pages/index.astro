---
import FormattedDate from '../components/FormattedDate.astro';
import PostCard from '../components/PostCard.astro';
import TagList from '../components/TagList.astro';
import { SITE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getVisiblePosts } from '../utils/posts';
import { personJsonLd, websiteJsonLd } from '../utils/seo';

const posts = await getVisiblePosts();
const [featured, ...others] = posts;
const recent = others.slice(0, 5);
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  jsonLd={[websiteJsonLd(), personJsonLd()]}
>
  <section class="py-6">
    <p class="font-mono text-sm text-sky-700 dark:text-sky-400">{SITE.tagline}</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-100">
      {SITE.title}
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-400">{SITE.description}</p>

    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href="/blog"
        class="rounded-md bg-sky-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-sky-800"
      >
        Tous les articles
      </a>
      <a
        href="/rss.xml"
        class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-sky-400 hover:text-sky-700 dark:border-slate-700 dark:text-slate-300 dark:hover:border-sky-500 dark:hover:text-sky-300"
      >
        S'abonner (RSS)
      </a>
    </div>
  </section>

  {featured && (
    <section class="mt-10">
      <h2 class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">
        À la une
      </h2>
      <article class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 dark:border-slate-800 dark:bg-slate-900">
        <p class="text-xs text-slate-500 dark:text-slate-400">
          <FormattedDate date={featured.data.pubDate} />
        </p>
        <h3 class="mt-2 text-2xl font-bold text-slate-900 dark:text-slate-100">
          <a href={`/blog/${featured.id}`} class="hover:underline">
            {featured.data.title}
          </a>
        </h3>
        <p class="mt-3 text-slate-600 dark:text-slate-400">{featured.data.description}</p>
        <TagList tags={featured.data.tags} class="mt-4" />
      </article>
    </section>
  )}

  <section class="mt-14">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">Derniers articles</h2>
      <a href="/blog" class="text-sm font-medium text-sky-700 hover:underline dark:text-sky-400">
        Voir tout →
      </a>
    </div>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {recent.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</BaseLayout>
