---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../utils/posts';
import { summarizeTerms } from '../../utils/taxonomy';

const posts = await getPublishedPosts();
const tags = summarizeTerms(posts, 'tags');
---

<BaseLayout
  title="Tags"
  description={`Tous les mots-clés des articles de ${SITE.title}.`}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `Tags — ${SITE.title}`,
  }}
>
  <Breadcrumbs items={[{ label: 'Accueil', href: '/' }, { label: 'Tags' }]} />

  <header class="mt-6">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Tags</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">{tags.length} mots-clés au total.</p>
  </header>

  <ul class="mt-8 flex flex-wrap gap-3">
    {tags.map((tag) => (
      <li>
        <a
          href={`/tags/${tag.slug}`}
          class="inline-flex items-center gap-2 rounded-full border border-slate-300 px-3 py-1 text-sm font-medium text-slate-700 transition hover:border-sky-400 hover:text-sky-700 dark:border-slate-700 dark:text-slate-300 dark:hover:border-sky-500 dark:hover:text-sky-300"
        >
          #{tag.term}
          <span class="rounded-full bg-slate-100 px-1.5 text-xs text-slate-500 dark:bg-slate-800 dark:text-slate-400">
            {tag.count}
          </span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
