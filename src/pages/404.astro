---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page introuvable" description="La page demandée n'existe pas." noindex>
  <div class="py-20 text-center">
    <p class="font-mono text-6xl font-bold text-sky-700 dark:text-sky-400">404</p>
    <h1 class="mt-4 text-2xl font-bold text-slate-900 dark:text-slate-100">Page introuvable</h1>
    <p class="mt-3 text-slate-600 dark:text-slate-400">
      La page demandée n'existe pas ou a été déplacée.
    </p>
    <div class="mt-6 flex justify-center gap-3">
      <a
        href="/"
        class="rounded-md bg-sky-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-sky-800"
      >
        Retour à l'accueil
      </a>
      <a
        href="/blog"
        class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-sky-400 dark:border-slate-700 dark:text-slate-300"
      >
        Voir le blog
      </a>
    </div>
  </div>
</BaseLayout>
