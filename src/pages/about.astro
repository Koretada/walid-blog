---
import { getEntry, render } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getVisibleCertifications } from '../utils/certifications';
import { personJsonLd } from '../utils/seo';

const entry = await getEntry('pages', 'about');

if (!entry) {
  throw new Error(
    "Page introuvable : ajoutez le fichier 'src/content/pages/about.mdx' à la collection 'pages'."
  );
}

const { Content } = await render(entry);

// Les certifications alimentent aussi le JSON-LD `hasCredential` de la page.
const certifications = await getVisibleCertifications();
const credentials = certifications.map(({ data }) => ({
  name: data.name,
  issuer: data.issuer,
  url: data.verifyUrl,
}));
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  jsonLd={personJsonLd(credentials)}
>
  <Breadcrumbs items={[{ label: 'Accueil', href: '/' }, { label: entry.data.title }]} />

  <header class="mt-6">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
      {entry.data.title}
    </h1>
  </header>

  <div class="prose prose-slate mt-8 max-w-none dark:prose-invert">
    <Content />
  </div>

  <section class="mt-10 border-t border-slate-200 pt-6 dark:border-slate-800">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Me suivre</h2>
    <ul class="mt-3 flex flex-wrap gap-4 text-sm">
      <li>
        <a class="text-sky-700 hover:underline dark:text-sky-400" href={SITE.social.github}>
          GitHub
        </a>
      </li>
      <li>
        <a class="text-sky-700 hover:underline dark:text-sky-400" href={SITE.social.linkedin}>
          LinkedIn
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>
