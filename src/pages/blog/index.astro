---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Pagination from '../../components/Pagination.astro';
import PostCard from '../../components/PostCard.astro';
import { POSTS_PER_PAGE, SITE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVisiblePosts, pageCount, paginate } from '../../utils/posts';
import { breadcrumbJsonLd } from '../../utils/seo';

const posts = await getVisiblePosts();
// En production, les brouillons ne sont jamais récupérés : ce compteur vaut 0.
const drafts = posts.filter((post) => post.data.draft);
const publishedCount = posts.length - drafts.length;

const totalPages = pageCount(posts.length, POSTS_PER_PAGE);
const items = paginate(posts, POSTS_PER_PAGE, 1);
---

<BaseLayout
  title="Articles"
  description={`Tous les articles de ${SITE.title} : Cloud, DevSecOps, Infrastructure-as-Code et observabilité.`}
  jsonLd={breadcrumbJsonLd([
    { name: 'Accueil', url: '/' },
    { name: 'Articles', url: '/blog' },
  ])}
>
  <Breadcrumbs items={[{ label: 'Accueil', href: '/' }, { label: 'Articles' }]} />

  <header class="mt-6">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Articles</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">
      {publishedCount}
      {publishedCount > 1 ? 'articles publiés' : 'article publié'} — Cloud, DevSecOps, IaC et
      observabilité.
      {drafts.length > 0 && (
        <>
          {' '}
          <span class="text-amber-700 dark:text-amber-400">
            (+ {drafts.length} brouillon{drafts.length > 1 ? 's' : ''} )
          </span>
        </>
      )}
    </p>
  </header>

  {drafts.length > 0 && (
    <aside
      class="mt-6 rounded-lg border border-dashed border-amber-400 bg-amber-50 p-4 text-sm dark:border-amber-700 dark:bg-amber-950/40"
      aria-label="Brouillons en attente de publication"
    >
      <p class="font-semibold text-amber-900 dark:text-amber-200">
        {drafts.length} brouillon{drafts.length > 1 ? 's' : ''} non publié
        {drafts.length > 1 ? 's' : ''}
      </p>
      <p class="mt-1 text-amber-800 dark:text-amber-300">
        Visible uniquement en développement. Passez <code>draft: false</code> dans le frontmatter
        pour publier.
      </p>
      <ul class="mt-2 list-inside list-disc text-amber-900 dark:text-amber-200">
        {drafts.map((draft) => (
          <li>
            <a href={`/blog/${draft.id}`} class="underline">
              {draft.data.title}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )}

  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((post) => (
      <PostCard post={post} />
    ))}
  </div>

  <Pagination page={1} totalPages={totalPages} base="/blog" />
</BaseLayout>
