---
interface Props {
  page: number;
  totalPages: number;
  /** URL de base, ex. « /blog » */
  base: string;
}

const { page, totalPages, base } = Astro.props;

// La page 1 correspond à `base`, les suivantes à `base/page/N`
const hrefFor = (target: number) => (target <= 1 ? base : `${base}/page/${target}`);

const linkClass =
  'rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:border-sky-400 hover:text-sky-700 dark:border-slate-700 dark:text-slate-300 dark:hover:border-sky-500 dark:hover:text-sky-300';
---

{totalPages > 1 && (
  <nav
    aria-label="Pagination"
    class="mt-10 flex items-center justify-between gap-4 border-t border-slate-200 pt-6 dark:border-slate-800"
  >
    {page > 1 ? (
      <a href={hrefFor(page - 1)} class={linkClass} rel="prev">
        ← Plus récents
      </a>
    ) : (
      <span aria-hidden="true" />
    )}

    <span class="text-sm text-slate-500 dark:text-slate-400">
      Page {page} / {totalPages}
    </span>

    {page < totalPages ? (
      <a href={hrefFor(page + 1)} class={linkClass} rel="next">
        Plus anciens →
      </a>
    ) : (
      <span aria-hidden="true" />
    )}
  </nav>
)}
