---
import { slugify } from '../utils/format';

interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className = '' } = Astro.props;
---

{tags.length > 0 && (
  <ul class:list={['flex flex-wrap gap-2', className]} aria-label="Mots-clés">
    {tags.map((tag) => (
      <li>
        <a
          href={`/tags/${slugify(tag)}`}
          class="inline-block rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600 transition hover:bg-sky-100 hover:text-sky-800 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-sky-900/50 dark:hover:text-sky-200"
        >
          #{tag}
        </a>
      </li>
    ))}
  </ul>
)}
