---
import type { Certification } from '../utils/certifications';
import FormattedDate from './FormattedDate.astro';

interface Props {
  certification: Certification;
}

const { certification } = Astro.props;
const {
  name,
  issuer,
  code,
  issued,
  expires,
  verifyUrl,
  credentialId,
  logo,
  logoAlt,
  accent,
  skills,
} = certification.data;

/**
 * Accents disponibles. Les classes Tailwind sont écrites en toutes lettres
 * (aucune concaténation) pour que le scan du build les détecte.
 */
const accents = {
  sky: {
    hover: 'hover:border-sky-400 dark:hover:border-sky-700',
    chip: 'bg-sky-50 text-sky-800 dark:bg-sky-950/50 dark:text-sky-300',
  },
  amber: {
    hover: 'hover:border-amber-400 dark:hover:border-amber-700',
    chip: 'bg-amber-50 text-amber-800 dark:bg-amber-950/50 dark:text-amber-300',
  },
  violet: {
    hover: 'hover:border-violet-400 dark:hover:border-violet-700',
    chip: 'bg-violet-50 text-violet-800 dark:bg-violet-950/50 dark:text-violet-300',
  },
  emerald: {
    hover: 'hover:border-emerald-400 dark:hover:border-emerald-700',
    chip: 'bg-emerald-50 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300',
  },
  red: {
    hover: 'hover:border-red-400 dark:hover:border-red-700',
    chip: 'bg-red-50 text-red-800 dark:bg-red-950/50 dark:text-red-300',
  },
  neutral: {
    hover: 'hover:border-slate-400 dark:hover:border-slate-600',
    chip: 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300',
  },
} as const;

const theme = accents[accent];

// Une certification sans date reste affichable ; le rappel n'apparaît qu'en
// développement pour ne pas oublier de compléter le frontmatter.
const missingDate = import.meta.env.DEV && !issued;
---

<li
  class:list={[
    'flex gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition dark:border-slate-800 dark:bg-slate-900',
    theme.hover,
  ]}
>
  {logo && (
    <img
      src={logo}
      alt={logoAlt ?? ''}
      width="56"
      height="56"
      loading="lazy"
      decoding="async"
      class="h-14 w-14 shrink-0 rounded-xl"
    />
  )}

  <div class="min-w-0 flex-1">
    <h3 class="text-base leading-snug font-semibold text-slate-900 dark:text-slate-100">{name}</h3>

    <p class="mt-0.5 text-sm text-slate-600 dark:text-slate-400">
      {issuer}
      {code && <span class="text-slate-400 dark:text-slate-500"> · {code}</span>}
    </p>

    {(issued || expires || credentialId || missingDate) && (
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
        {issued && (
          <>
            Obtenue le <FormattedDate date={issued} />
          </>
        )}
        {!issued && missingDate && (
          <span class="text-amber-700 dark:text-amber-400">Date d'obtention à renseigner</span>
        )}
        {expires && (
          <>
            {' · '}valable jusqu'au <FormattedDate date={expires} />
          </>
        )}
        {credentialId && (
          <>
            {' · ID '}
            <span class="font-mono text-[0.7rem] text-slate-600 dark:text-slate-300">
              {credentialId}
            </span>
          </>
        )}
      </p>
    )}

    {skills.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {skills.map((skill) => (
          <li class:list={['rounded-full px-2 py-0.5 text-xs font-medium', theme.chip]}>{skill}</li>
        ))}
      </ul>
    )}

    {verifyUrl && (
      <a
        href={verifyUrl}
        rel="noopener noreferrer nofollow"
        target="_blank"
        class="mt-3 inline-block text-xs font-medium text-sky-700 hover:underline dark:text-sky-400"
      >
        Vérifier le badge<span class="sr-only"> — {name}</span>
      </a>
    )}
  </div>
</li>
